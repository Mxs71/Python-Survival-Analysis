   "source": [
    "from lifelines.datasets import load_gbsg2\n",
    "import pandas as pd\n",
    "\n",
    "df = load_gbsg2()\n",
    "display(df)\n",
    "\n",
    "df = df.rename(columns = {'cens': 'event_observed', 'horTh': 'arm'})\n",
    "df['arm'] = df['arm'].map({'yes': 'treatment', 'no': 'control'})\n",
    "\n",
    "df.to_csv(\"../data/gbsg2.csv\", index = False)"
   ]
